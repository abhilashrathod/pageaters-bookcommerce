# Pageaters API — copy to .env and fill in. Never commit .env.
# Validated at boot by src/env.js: an invalid or missing [required] value stops the server with a message naming
# the variable and the rule (never the value). Empty values count as unset.
# [required] = the server refuses to boot without it. [optional] = only the feature that uses it fails.

# --- Core ---
# [optional, default development] One of: development | staging | production | test
# WARNING: never use `production` for a deployed demo — it sends real SMS and order emails
# to visitor-typed numbers/addresses (AGENTS.md §6). Use `development` or `staging`.
APP_ENV=development
# [optional, default 5005] HTTP port, a whole number 1–65535
PORT=5005
# [optional, default http://localhost:3000] Storefront base URL (http/https), used in password-reset and
# email-verification links
STOREFRONT_URL=http://localhost:3000
# [optional, default http://localhost:3000,http://localhost:4200] Comma-separated CORS allowlist; each item an
# http(s) origin with no path or trailing slash, e.g. https://demo.pageaters.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200
# [optional, default false] Run in-process cron jobs: true | false
ENABLE_CRON=false
# [required] JWT signing + AES-256 key; exactly 32 bytes (use 32 ASCII characters)
# Generate one with: openssl rand -base64 24
ENCRYPTION_KEY=

# --- Database ---
# [required] MongoDB connection string starting with mongodb:// or mongodb+srv://,
# e.g. mongodb://localhost:27017/pageaters_api. The seed loader reads it too.
MONGODB_URI=

# --- Payments (Razorpay) ---
# Test-mode keys only. The API refuses to boot with a live key (rzp_live_…).
# [required] Razorpay key ID; must start with rzp_test_. The client is created at module load
RAZORPAY_KEY_ID=
# [optional] Razorpay key secret — payment API calls fail without it
RAZORPAY_KEY_SECRET=
# [optional] Webhook secret for payment.captured and refund webhooks
RAZORPAY_WEBHOOK_SECRET=

# --- Shipping (Delhivery) ---
# [optional, default https://staging-express.delhivery.com] Delhivery API base URL (http/https)
DELHIVERY_BASE_URL=https://staging-express.delhivery.com
# [optional] Delhivery API token — pincode checks and shipment creation fail without it
DELHIVERY_API_TOKEN=

# --- SMS (Twilio) ---
# [required] Twilio account SID; must start with AC. The client is created at module load
TWILIO_ACCOUNT_SID=
# [required] Twilio auth token — the client is created at module load
TWILIO_AUTH_TOKEN=
# [optional] Twilio sender phone number, E.164 (+ and country code, digits only)
TWILIO_PHONE=

# --- Email (SendGrid) ---
# [optional] SendGrid API key — sending email fails without it
SENDGRID_API_KEY=
# [optional, default no-reply@demo.pageaters.com] Sender address for outgoing email; must be an email address
MAIL_FROM=no-reply@demo.pageaters.com

# --- Storage (S3 + image CDN) ---
# [optional] S3 region for admin uploads
S3_REGION=
# [optional] S3 access key ID — uploads fail without it
S3_ACCESS_KEY_ID=
# [optional] S3 secret access key — uploads fail without it
S3_SECRET_ACCESS_KEY=
# [optional] Image CDN base URL (http/https) used to build resized image links
IMAGE_CDN_URL=

# --- Seed only (not read by the API) ---
# The seed scripts in seed/ load this file (node --env-file-if-exists=../apps/api/.env) and read these.
# The API ignores them.
# [seed upload] Vercel Blob read-write token for the seed image upload (pnpm --filter @pageaters/seed upload)
BLOB_READ_WRITE_TOKEN=
# [seed accounts/load] The owner's super-admin login, created by the seed loader (pnpm seed). Use your own address
# (log in with it in lowercase, at most 50 characters) and a unique password of 12–50 characters; only a salted
# hash is stored
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
