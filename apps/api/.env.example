# Pageaters API — copy to .env and fill in. Never commit .env.
# [required] = the server fails to boot without it. [optional] = only the feature that uses it fails.

# --- Core ---
# [optional] Runtime environment. Valid values: development | staging | production | test
# WARNING: never use `production` for a deployed demo — it sends real SMS and order emails
# to visitor-typed numbers/addresses (AGENTS.md §6). Use `development` or `staging`.
APP_ENV=development
# [optional] HTTP port
PORT=5005
# [optional] Storefront base URL, used in password-reset and email-verification links
STOREFRONT_URL=http://localhost:3000
# [optional] Comma-separated CORS allowlist
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200
# [optional] Run in-process cron jobs (true | false)
ENABLE_CRON=false
# [optional] JWT signing + AES-256 key; must be exactly 32 characters. Login/auth fails without it
ENCRYPTION_KEY=

# --- Database ---
# [required] MongoDB connection string, e.g. mongodb://localhost:27017/pageaters
MONGODB_URI=

# --- Payments (Razorpay) ---
# Test-mode keys only (rzp_test_…). Never use rzp_live_ keys.
# [required] Razorpay key ID — the client is created at module load and throws if empty
RAZORPAY_KEY_ID=
# [optional] Razorpay key secret — payment API calls fail without it
RAZORPAY_KEY_SECRET=
# [optional] Webhook secret for payment.captured and refund webhooks
RAZORPAY_WEBHOOK_SECRET=

# --- Shipping (Delhivery) ---
# [optional] Delhivery API base URL
DELHIVERY_BASE_URL=https://staging-express.delhivery.com
# [optional] Delhivery API token — pincode checks and shipment creation fail without it
DELHIVERY_API_TOKEN=

# --- SMS (Twilio) ---
# [required] Twilio account SID (must start with AC) — the client is created at module load and throws otherwise
TWILIO_ACCOUNT_SID=
# [required] Twilio auth token — the client throws at module load if empty
TWILIO_AUTH_TOKEN=
# [optional] Twilio sender phone number (E.164)
TWILIO_PHONE=

# --- Email (SendGrid) ---
# [optional] SendGrid API key — sending email fails without it
SENDGRID_API_KEY=
# [optional] Sender address for outgoing email
MAIL_FROM=no-reply@demo.pageaters.com

# --- Storage (S3 + image CDN) ---
# [optional] S3 region for admin uploads
S3_REGION=
# [optional] S3 access key ID — uploads fail without it
S3_ACCESS_KEY_ID=
# [optional] S3 secret access key — uploads fail without it
S3_SECRET_ACCESS_KEY=
# [optional] Image CDN base URL used to build resized image links
IMAGE_CDN_URL=

# --- Storage (Vercel Blob) ---
# [optional] Vercel Blob read-write token. Used now only by the seed image upload
# (pnpm --filter @pageaters/seed upload); the Phase 4 storage adapter replaces S3 with it
BLOB_READ_WRITE_TOKEN=
