# Pageaters API — copy to .env and fill in. Never commit .env.
# Validated at boot by src/env.js: an invalid or missing [required] value stops the server with a message naming
# the variable and the rule (never the value). Empty values count as unset.
# [required] = the server refuses to boot without it. [optional] = only the feature that uses it fails.

# --- Core ---
# [optional, default development] One of: development | staging | production | test
# `production` turns on the legacy production-only order SMS and e-mails; they still go through the adapters
# below, so a deployed demo must keep EMAIL_ADAPTER and SMS_ADAPTER at mock (AGENTS.md §6).
APP_ENV=development
# [optional, default 5005] HTTP port, a whole number 1–65535
PORT=5005
# [optional, default http://localhost:3000] Storefront base URL (http/https), used in every storefront link the API
# builds: e-mail templates (reset, verify, orders, stock alerts), sitemap.xml and googleproducts.xml
STOREFRONT_URL=http://localhost:3000
# [optional, default http://localhost:3000,http://localhost:4200] Comma-separated CORS allowlist; each item an
# http(s) origin with no path or trailing slash, e.g. https://demo.pageaters.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200
# [optional] Set by Vercel itself (VERCEL=1); leave unset locally. On Vercel the API trusts one proxy hop for the
# client IP (rate limits) and refuses APP_ENV=test.
VERCEL=
# [required] root secret: the JWT signing key is derived from it (HKDF); exactly 32 bytes (use 32 ASCII characters)
# Generate one with: openssl rand -base64 24
ENCRYPTION_KEY=

# --- Database ---
# [required] MongoDB connection string starting with mongodb:// or mongodb+srv://,
# e.g. mongodb://localhost:27017/pageaters_api. The seed loader reads it too.
MONGODB_URI=

# --- Adapters (src/adapters/README.md) ---
# Each third-party service has a real and a mock adapter. The mock is the default: nothing leaves the API (messages,
# payment orders, shipments and uploads are kept in memory). A real adapter is used only when selected here, and
# only then are its keys required. Never select a real e-mail or SMS adapter on the public demo (AGENTS.md §6).
# [optional, default mock] One of: mock | sendgrid. sendgrid requires SENDGRID_API_KEY and MAIL_FROM
EMAIL_ADAPTER=mock
# [optional, default mock] One of: mock | twilio. twilio requires TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_PHONE
SMS_ADAPTER=mock
# [optional, default mock] One of: mock | razorpay. razorpay requires RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET and
# RAZORPAY_WEBHOOK_SECRET (test mode; the demo's Razorpay test checkout uses razorpay with test keys)
PAYMENTS_ADAPTER=mock
# [optional, default mock] One of: mock | delhivery. delhivery requires DELHIVERY_API_TOKEN
SHIPPING_ADAPTER=mock
# [optional, default mock] One of: mock | blob. blob (Vercel Blob) requires BLOB_READ_WRITE_TOKEN
STORAGE_ADAPTER=mock

# --- Payments (Razorpay; read only when PAYMENTS_ADAPTER=razorpay) ---
# Test-mode keys only. Whenever RAZORPAY_KEY_ID is set — whichever PAYMENTS_ADAPTER is selected — it must start
# with rzp_test_, and the API refuses to boot with a live key (rzp_live_…).
# [required with PAYMENTS_ADAPTER=razorpay] Razorpay key ID; must start with rzp_test_
RAZORPAY_KEY_ID=
# [required with PAYMENTS_ADAPTER=razorpay] Razorpay key secret
RAZORPAY_KEY_SECRET=
# [required with PAYMENTS_ADAPTER=razorpay, and whenever APP_ENV is staging or production; optional otherwise]
# Webhook secret for the payment.captured and refund webhooks. Both payments adapters check signatures with it
# (the mock uses Razorpay's scheme too, so set one to run checkout → webhook locally); unset, no webhook verifies
RAZORPAY_WEBHOOK_SECRET=

# --- Shipping (Delhivery; read only when SHIPPING_ADAPTER=delhivery) ---
# [optional, default https://staging-express.delhivery.com] Delhivery API base URL (http/https), no trailing slash
DELHIVERY_BASE_URL=https://staging-express.delhivery.com
# [required with SHIPPING_ADAPTER=delhivery] Delhivery API token (sent only in the Authorization header)
DELHIVERY_API_TOKEN=

# --- SMS (Twilio; read only when SMS_ADAPTER=twilio) ---
# [required with SMS_ADAPTER=twilio] Twilio account SID; must start with AC
TWILIO_ACCOUNT_SID=
# [required with SMS_ADAPTER=twilio] Twilio auth token
TWILIO_AUTH_TOKEN=
# [required with SMS_ADAPTER=twilio] Twilio sender phone number, E.164 (+ and country code, digits only)
TWILIO_PHONE=

# --- Email (SendGrid; the key is read only when EMAIL_ADAPTER=sendgrid) ---
# [required with EMAIL_ADAPTER=sendgrid] SendGrid API key
SENDGRID_API_KEY=
# [required with EMAIL_ADAPTER=sendgrid; otherwise default no-reply@demo.pageaters.com] Sender address of every
# e-mail (also recorded in the mail log); must be an email address
MAIL_FROM=no-reply@demo.pageaters.com

# --- Storage (Vercel Blob; the API reads it only when STORAGE_ADAPTER=blob) ---
# [required with STORAGE_ADAPTER=blob; also read by the seed image upload, pnpm --filter @pageaters/seed upload]
# Vercel Blob read-write token: admin uploads go to the same store as the seed's catalog images
BLOB_READ_WRITE_TOKEN=

# --- Seed only (not read by the API) ---
# The seed scripts in seed/ load this file (node --env-file-if-exists=../apps/api/.env) and read these.
# The API ignores them.
# [seed accounts/load] The owner's super-admin login, created by the seed loader (pnpm seed). Use your own address
# (log in with it in lowercase, at most 50 characters) and a unique password of 12–50 characters; only a salted
# hash is stored
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
