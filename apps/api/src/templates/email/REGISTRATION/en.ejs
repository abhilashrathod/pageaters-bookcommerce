<body>
<div class="wrapper">
    <div class="mb-4">
        <svg
                data-name="Layer 1"
                width="64px"
                height="64px"
                xmlns="http://www.w3.org/2000/svg"
                xmlns:xlink="http://www.w3.org/1999/xlink"
                viewBox="0 0 252.61 266.37"
        >
            <defs>
                <linearGradient
                        id="a"
                        x1="137.54"
                        y1="259.36"
                        x2="392.65"
                        y2="259.36"
                        gradientTransform="rotate(.75 162.65 -361.656)"
                        gradientUnits="userSpaceOnUse"
                >
                    <stop offset="0" stop-color="#ff512f"/>
                    <stop offset="1" stop-color="#f09819"/>
                </linearGradient>
                <linearGradient
                        id="b"
                        x1="320.88"
                        y1="132.29"
                        x2="325.5"
                        y2="132.29"
                        xlink:href="#a"
                />
                <linearGradient
                        id="c"
                        x1="324.3"
                        y1="121.87"
                        x2="330.85"
                        y2="121.87"
                        xlink:href="#a"
                />
            </defs>
            <path
                    d="M332.42 157.25a27.76 27.76 0 01-32.31-4.62 27.92 27.92 0 01-49.91-18.38l-119.55 30.36 46.44 182.81 89.54 39.64 116.63-29.63z"
                    transform="translate(-130.65 -120.7)"
                    fill="url(#a)"
            />
            <path
                    d="M101.18 202.88l-54.7 24 85.34 37.64 4.1 1.83z"
                    fill="#ef5214"
            />
            <path
                    d="M317.28 136.58a2.31 2.31 0 10-2.81-1.67 2.3 2.3 0 002.81 1.67z"
                    transform="translate(-130.65 -120.7)"
                    fill="url(#b)"
            />
            <path
                    d="M322 127.15a3.28 3.28 0 10-4-2.37 3.29 3.29 0 004 2.37z"
                    transform="translate(-130.65 -120.7)"
                    fill="url(#c)"
            />
        </svg>
    </div>
    <h1 class="header pt-2 pb-8">
        Congratulations, <br/>
        you are a <strong>Pageater!</strong>
    </h1>
    <p class="pb-2">
        We're extremly happy to have you on our bookish squad.
        Hope you have ton of fun book shopping with us.
    </p>
    <p class="pb-8">
        Click on the link below to complete your registration and start jumping into our bookshelves!
    </p>
    <a class="button primary mb-4 inline-block" href=<%= LINK %>>
        COMPLETE REGISTRATION
    </a>
    <p class="mt-2 mb-6">
        If you need any help, don’t hesitate to reach out to us at
        support@demo.pageaters.com!
        <br/>
    </p>
    <p class="small fw-bold mt-2 mb-4">Team Pageaters</p>
    <div class="social-media">
        <a href="https://twitter.com/pageaters" class="mr-4">
            <img
                    width="24"
                    height="24"
                    src="https://superpeer.dev/emails/twitter.png"
            />
        </a>
        <a href="https://instagram.com/the.pageaters">
            <img
                    width="24"
                    height="24"
                    src="https://superpeer.dev/emails/instagram.png"
            />
        </a>
    </div>
</div>
<div class="wrapper lineless">
    <p class="fine-print pb-8">
        Have questions or need help? email us at
        <a href="mailto:support@demo.pageaters.com">support@demo.pageaters.com</a>
    </p>
    <p class="fine-print inline-block">
        <a href="https://pageaters.com/terms-and-conditions">Terms of Service</a>
        and
        <a href="https://pageaters.com/privacy-policy">Privacy Policy</a>
    </p>
    <p class="fine-print inline-block right-0 pr-8 mr-8">Pageaters Inc 2021-2022</p>
</div>
