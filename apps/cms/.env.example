# Pageaters CMS (Payload) — copy to .env and fill in. Never commit .env.
# Validated at boot by src/env.ts: a missing or invalid value stops the CMS with a message naming the variable and
# the rule (never the value). Empty values count as unset.

# [required] The CMS's own MongoDB database (never the API's pageaters_api), e.g.
# mongodb+srv://<user>:<password>@<cluster>/pageaters_cms?retryWrites=true&w=majority
MONGODB_URI=
# [required] Signs CMS sessions; at least 32 characters. Generate one with: openssl rand -base64 32
PAYLOAD_SECRET=
# [optional; required on Vercel] Vercel Blob read/write token (the same store as the API and seed images). Unset:
# media files are written to apps/cms/media/ (gitignored), for local development only.
BLOB_READ_WRITE_TOKEN=
# [optional] Set by Vercel itself (VERCEL=1); leave unset locally. On Vercel the Blob token is required.
VERCEL=
