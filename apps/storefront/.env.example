# Pageaters storefront (Next.js App Router) — copy to .env.local for local dev. Never commit it.
# Validated at boot by src/env.ts: a missing or invalid value stops the storefront with a message naming the
# variable and the rule (never the value). Empty values count as unset.

# [optional, default http://localhost:5005/api/v1] The API root (version prefix included), read server-side for
# catalog data.
API_URL=http://localhost:5005/api/v1
# [optional, default http://localhost:5005/api/v1] The API root as the visitor's browser reaches it, for shopper calls
# (cart, checkout, orders) sent with the API's httpOnly cookies. Public: inlined into the client bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:5005/api/v1
# [optional, default http://localhost:3001] The CMS (Payload) origin; content is read from its REST API at /api.
CMS_URL=http://localhost:3001
# [optional, default http://localhost:3000] The storefront's public origin (no trailing slash), for metadata URLs.
SITE_URL=http://localhost:3000

# [optional, at least 32 characters] Same value as the CMS's PREVIEW_SECRET: lets the CMS turn on draft mode for live
# preview (GET /api/draft). Unset = preview off.
PREVIEW_SECRET=
# [optional, at least 32 characters] Same value as the CMS's REVALIDATE_SECRET: lets the CMS drop cached content after
# a publish (POST /api/revalidate). Unset = revalidation off (CMS content refreshes on the next deploy).
REVALIDATE_SECRET=
