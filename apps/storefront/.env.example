# Storefront (legacy Pages Router) environment. Copy to .env.local for local dev.
# NEXT_PUBLIC_* values are inlined into the client bundle at build time: never put secrets here.

# [required] API base URL incl. /api/v1 (request paths are relative, e.g. /categories); local API runs on port 5005.
NEXT_PUBLIC_BASE_PATH=http://localhost:5005/api/v1

# [required] Public storefront origin, used for og:url, share links and JSON-LD (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# [required] Must be exactly true or false (JSON.parse in pages/_app.tsx); false disables Google Analytics.
NEXT_PUBLIC_PRODUCTION=false

# [optional] Razorpay TEST-mode key id only (rzp_test_...), never rzp_live_; needed only to open checkout payment.
NEXT_PUBLIC_RAZOR_KEY=

# [optional] Base URL of the image-resizing CDN (serverless image handler: GET <url>/<base64 {bucket,key,edits.resize}>), no trailing slash; empty = broken images, pages still render.
NEXT_PUBLIC_IMAGE_CLOUDFRONT_URL=
