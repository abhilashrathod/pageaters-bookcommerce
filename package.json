{
  "name": "pageaters",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "seed": "pnpm --filter @pageaters/seed load",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@pageaters/config": "workspace:*",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10"
  },
  "license": "UNLICENSED"
}
