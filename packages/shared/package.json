{
  "name": "@pageaters/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./gift-packages": {
      "types": "./dist/commerce/gift-packages.d.ts",
      "default": "./dist/commerce/gift-packages.js"
    }
  },
  "typesVersions": {
    "*": {
      "gift-packages": [
        "./dist/commerce/gift-packages.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && esbuild src/index.ts --bundle --platform=node --format=cjs --target=node22 --packages=external --outfile=dist/index.cjs --log-level=warning",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.build.json && node --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@pageaters/config": "workspace:*",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "typescript": "6.0.3"
  },
  "license": "UNLICENSED"
}
